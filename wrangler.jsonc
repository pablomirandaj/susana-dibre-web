{
  // Configuración de despliegue en Cloudflare Workers.
  //
  // IMPORTANTE: cada despliegue sustituye las variables de texto del panel
  // por las declaradas aquí. Por eso SUPABASE_URL vive en este archivo: si
  // se pone solo en el panel, el siguiente despliegue la borra.
  //
  // Los secretos NO van aquí. Se cargan en el panel de Cloudflare
  // (Bindings > Secret) y sobreviven a los despliegues.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "susana-dibre-web",
  "compatibility_date": "2026-08-31",
  "main": "worker/index.js",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "vars": {
    "SUPABASE_URL": "https://rwupkpfdjpeqasadeyxm.supabase.co"
  },
  "observability": {
    "enabled": true
  }
}
