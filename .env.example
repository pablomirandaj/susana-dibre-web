# ---------------------------------------------------------------------------
# Variables de entorno. Copiar a .env en local y cargarlas en Cloudflare Pages
# (Settings > Environment variables). Nunca subir valores reales al repositorio.
# ---------------------------------------------------------------------------

# Supabase — proyecto de base de datos y autenticación
SUPABASE_URL=
SUPABASE_ANON_KEY=            # pública, va al panel; protegida por RLS
SUPABASE_SERVICE_ROLE_KEY=    # SECRETA. Solo en Cloudflare, nunca en el navegador

# Google Analytics 4 (opcional, aún sin configurar)
GA4_MEASUREMENT_ID=
